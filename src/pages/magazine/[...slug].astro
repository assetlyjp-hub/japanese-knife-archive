---
// magazine/[...slug].astro - 記事詳細ページ
// Markdownの記事をレンダリングして表示

import Article from '../../layouts/Article.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import { getCollection, render } from 'astro:content';
import knivesData from '../../data/knives.json';

// 静的パス生成（全記事からパスを生成）
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

// 記事データを取得
const { article } = Astro.props;

// MarkdownをHTMLにレンダリング
const { Content } = await render(article);

// relatedKnivesからIDでマッチする包丁データを取得
const relatedIds = article.data.relatedKnives || [];
const matchedKnives = relatedIds.map((id: string) =>
  knivesData.find((k: any) => k.id === id)
).filter(Boolean);

// 英語記事かどうかをスラッグから判定
const isEn = article.id.startsWith('en/');
---

<Article
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  tags={article.data.tags}
>
  <Content />
  <RelatedProducts knives={matchedKnives} lang={isEn ? 'en' : 'ja'} />
</Article>
