---
// SteelRadar.astro - 鋼材のレーダーチャート（SVGで描画）
// 5つのスペック（刃持ち・耐食性・研ぎやすさ・靭性・硬度）をレーダーで表示

interface Props {
  edgeRetention: number;      // 刃持ち（1-5）
  corrosionResistance: number; // 耐食性（1-5）
  easeOfSharpening: number;   // 研ぎやすさ（1-5）
  toughness: number;          // 靭性（1-5）
  hardness: string;           // 硬度（HRC文字列）
  size?: number;              // SVGサイズ（デフォルト200）
}

const {
  edgeRetention,
  corrosionResistance,
  easeOfSharpening,
  toughness,
  hardness,
  size = 200,
} = Astro.props;

// HRC文字列から数値を取得（例: "60-62" → 61）
const hrcMatch = hardness.match(/(\d+)/);
const hrcValue = hrcMatch ? parseInt(hrcMatch[1]) : 60;
// HRCを1-5スケールに変換（55=1, 67=5）
const hardnessScore = Math.min(5, Math.max(1, Math.round((hrcValue - 55) / 3 + 1)));

// 5つの値を配列に
const values = [edgeRetention, corrosionResistance, easeOfSharpening, toughness, hardnessScore];
const labels = ['Edge Retention', 'Corrosion Resistance', 'Ease of Sharpening', 'Toughness', 'Hardness'];

// レーダーチャートの計算
const center = size / 2;
const maxRadius = (size / 2) - 30;  // ラベル分の余白
const angles = values.map((_, i) => (Math.PI * 2 * i) / values.length - Math.PI / 2);

// 各値の座標を計算する関数
function getPoint(value: number, index: number): [number, number] {
  const radius = (value / 5) * maxRadius;
  return [
    center + radius * Math.cos(angles[index]),
    center + radius * Math.sin(angles[index]),
  ];
}

// データポイントのパスを生成
const dataPoints = values.map((v, i) => getPoint(v, i));
const dataPath = dataPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${p[0]},${p[1]}`).join(' ') + 'Z';

// グリッド線のパスを生成（5段階）
function getGridPath(level: number): string {
  const points = angles.map((_, i) => getPoint(level, i));
  return points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p[0]},${p[1]}`).join(' ') + 'Z';
}

// ラベルの座標（グリッドの外側に配置）
const labelPoints = angles.map((angle, _i) => [
  center + (maxRadius + 20) * Math.cos(angle),
  center + (maxRadius + 20) * Math.sin(angle),
]);
---

<svg viewBox={`0 0 ${size} ${size}`} class="radar-chart" xmlns="http://www.w3.org/2000/svg">
  <!-- グリッド線（5段階） -->
  {[1, 2, 3, 4, 5].map(level => (
    <path d={getGridPath(level)} fill="none" stroke="#3A3A3A"
          stroke-width={level === 5 ? 1 : 0.5} opacity={level === 5 ? 0.8 : 0.4} />
  ))}

  <!-- 軸線（中心から各頂点へ） -->
  {angles.map((_, i) => {
    const [x, y] = getPoint(5, i);
    return <line x1={center} y1={center} x2={x} y2={y} stroke="#3A3A3A" stroke-width="0.5" opacity="0.4" />;
  })}

  <!-- データエリア（塗りつぶし） -->
  <path d={dataPath} fill="rgba(197, 165, 114, 0.2)" stroke="#C5A572" stroke-width="2" />

  <!-- データポイント（丸） -->
  {dataPoints.map(([x, y]) => (
    <circle cx={x} cy={y} r="3" fill="#C5A572" />
  ))}

  <!-- ラベル -->
  {labels.map((label, i) => (
    <text
      x={labelPoints[i][0]}
      y={labelPoints[i][1]}
      text-anchor="middle"
      dominant-baseline="central"
      font-family="DM Sans, Inter, sans-serif"
      font-size="8"
      fill="#999"
    >
      {label}
    </text>
  ))}
</svg>
